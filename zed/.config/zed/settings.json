// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "existing_window",
  "session": {
    "trust_all_worktrees": true,
  },
  "theme": "Twilight Light",
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "vertical_scroll_margin": 6,
  "diff_view_style": "split",
  "use_system_window_tabs": true,
  "file_finder": {
    "file_icons": true,
  },
  "markdown_preview_font_family": "Inter",
  "completion_menu_item_kind": "symbol",
  // Font
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 17.0,
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  // "ui_font_family": "JetBrainsMono Nerd Font Mono",
  // "ui_font_family": "Braun Linear",
  "ui_font_family": ".SystemUIFont",
  "title_bar": {
    "show_branch_icon": false, // Show/hide branch icon beside branch switcher
    "show_branch_name": false, // Show/hide branch name
    "show_branch_status_icon": false,
    "show_project_items": false, // Show/hide project host and name
    "show_onboarding_banner": false, // Show/hide onboarding banners
    "show_user_picture": false, // Show/hide user avatar
    "show_sign_in": false, // Show/hide sign-in button
    "show_menus": false, // Show/hide menus
    "show_user_menu": false,
  },
  "relative_line_numbers": "disabled",
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": false,

  // "buffer_font_family": "Iosevka SS08",
  // "buffer_font_family": "CommitMono",
  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features": {
    "zero": 1,
  },
  "buffer_line_height": "comfortable",
  "current_line_highlight": "none",
  "centered_layout": {
    "left_padding": 0.125,
    "right_padding": 0.125,
  },
  "active_pane_modifiers": {
    "border_size": 0,
    "inactive_opacity": 1.0,
  },
  "terminal": {
    "button": false,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "blinking": "on",
    "default_height": 460,
    "cursor_shape": "bar",
  },
  "scrollbar": {
    "show": "never",
    "cursors": false,
    "git_diff": false,
    "search_results": false,
    "selected_symbol": false,
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "search": {
    "button": false,
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },
  "git_panel": {
    "dock": "right",
    "tree_view": false,
    "button": true,
  },
  "inline_code_actions": false,
  "gutter": {
    "breakpoints": false,
    "runnables": false,
    "min_line_number_digits": 3,
    "folds": true,
    "line_numbers": true,
  },
  "indent_guides": {
    "enabled": false,
    // "coloring": "indent_aware",
    // "line_width": 1,
  },
  "vim": {
    "use_system_clipboard": "always",
  },
  "project_panel": {
    "git_status": true,
    "button": true,
    "folder_icons": true,
    "indent_guides": {
      "show": "never",
    },
    "show_diagnostics": "errors",
    "sticky_scroll": false,
    "hide_root": true,
    "bold_folder_labels": false,
    "default_width": 375,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
    "button": false,
  },
  // Top bar
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": true,
    "code_actions": false,
    "selections_menu": false,
  },
  // Status bar stuff
  "notification_panel": {
    "button": false,
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 100,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "file_icons": true,
    "close_position": "right",
    "git_status": true,
  },
  // Edit prediction
  "max_tabs": 5,
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    "experimental.show": false,
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "show_call_status_icon": false,
  // Error lens
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 500,
      "max_severity": "error",
    },
  },
  "diagnostics_max_severity": "warning",
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "semantic_tokens": "combined",
}
