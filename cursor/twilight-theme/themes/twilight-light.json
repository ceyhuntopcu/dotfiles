    "editorSuggestWidget.background": "#f1f2f6",
    "editorSuggestWidget.selectedBackground": "#dbe1f1",
    "editorHoverWidget.background": "#f1f2f6",
    "peekViewEditor.background": "#f1f2f6",
    "terminal.background": "#f9f8f4",
    "terminal.foreground": "#3b4261",
    "terminalCursor.foreground": "#3b4261",
    "terminal.ansiBlack": "#3b4261",
    "terminal.ansiRed": "#c4485a",
    "terminal.ansiGreen": "#4a9aa6",
    "terminal.ansiYellow": "#c46a3f",
    "terminal.ansiBlue": "#3d6bd6",
    "terminal.ansiMagenta": "#9854c0",
    "terminal.ansiCyan": "#4a6bc5",
    "terminal.ansiWhite": "#6b7394",
    "terminal.ansiBrightBlack": "#8b91a8",
    "terminal.ansiBrightRed": "#c4485a",
    "terminal.ansiBrightGreen": "#4a9aa6",
    "terminal.ansiBrightYellow": "#c46a3f",
    "terminal.ansiBrightBlue": "#3d6bd6",
    "terminal.ansiBrightMagenta": "#9854c0",
    "terminal.ansiBrightCyan": "#4a6bc5",
