    "gitDecoration.untrackedResourceForeground": "#4a9aa6",
    "gitDecoration.ignoredResourceForeground": "#8b91a8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8b91a8", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#4a9aa6" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#c46a3f" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#9854c0" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#3d6bd6" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#3d6bd6" } },
    { "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"], "settings": { "foreground": "#4a6bc5" } },
    { "scope": ["variable", "meta.definition.variable.name", "variable.other"], "settings": { "foreground": "#3b4261" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#6b7394" } },
    { "scope": ["entity.name.tag", "support.constant"], "settings": { "foreground": "#c4485a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c46a3f" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#6b7394" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#4a6bc5", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
  ]
}
