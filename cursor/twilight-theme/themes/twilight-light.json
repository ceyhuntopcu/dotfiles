    "editor.findMatchBackground": "#c8d3f5",
    "editor.findMatchHighlightBackground": "#c8d3f588",
    "editorWhitespace.foreground": "#cdd0db",
    "editorIndentGuide.background1": "#e6e7ee",
    "editorIndentGuide.activeBackground1": "#b3b8c9",
    "editorBracketMatch.background": "#dbe1f1",
    "editorBracketMatch.border": "#4a6bc5",
    "editorError.foreground": "#c4485a",
    "editorWarning.foreground": "#c46a3f",
    "editorInfo.foreground": "#4a6bc5",
    "activityBar.background": "#f1f2f6",
