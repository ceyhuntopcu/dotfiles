{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "zed-twilight-minimal",
  "mouse": false,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "stacked",
  "prompt": {
    "max_width": "auto",
    "max_height": 8
  },
  "plugin_enabled": {
    "internal:sidebar-context": false,
    "internal:sidebar-mcp": false,
    "internal:sidebar-lsp": false,
    "internal:sidebar-todo": false,
    "internal:sidebar-files": false,
    "internal:sidebar-footer": false
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+p",
    "sidebar_toggle": "none",
    "scrollbar_toggle": "none",
    "status_view": "none",
    "tool_details": "none",
    "display_thinking": "none",
    "session_toggle_timestamps": "none",
    "session_toggle_generic_tool_output": "none",
    "messages_toggle_conceal": "none"
  }
}
