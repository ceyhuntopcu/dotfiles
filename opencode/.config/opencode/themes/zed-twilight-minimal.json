{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#1f2335",
    "darkFg": "#a9b1d6",
    "darkMuted": "#8089b3",
    "darkSubtle": "#414868",
    "darkSelection": "#364a82",
    "darkBlue": "#7aa2f7",
    "darkPurple": "#ca9ee6",
    "darkRed": "#F0879A",
    "darkOrange": "#F0AC8B",
    "lightBg": "#f9f8f4",
    "lightFg": "#3b4261",
    "lightMuted": "#6b7394",
    "lightSubtle": "#a9b1d6",
    "lightSelection": "#c8d3f5",
    "lightBlue": "#3d6bd6",
    "lightPurple": "#9854c0",
    "lightRed": "#c4485a",
    "lightOrange": "#c46a3f"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightBlue" },
    "secondary": { "dark": "darkPurple", "light": "lightPurple" },
    "accent": { "dark": "darkOrange", "light": "lightOrange" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkOrange", "light": "lightOrange" },
    "success": { "dark": "darkBlue", "light": "lightBlue" },
    "info": { "dark": "darkBlue", "light": "lightBlue" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkBg", "light": "lightBg" },
    "backgroundElement": { "dark": "darkBg", "light": "lightBg" },
    "border": { "dark": "darkBg", "light": "lightBg" },
    "borderActive": { "dark": "darkSubtle", "light": "lightSubtle" },
    "borderSubtle": { "dark": "darkBg", "light": "lightBg" },
    "diffAdded": { "dark": "darkBlue", "light": "lightBlue" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkOrange", "light": "lightOrange" },
    "diffHighlightAdded": { "dark": "darkBlue", "light": "lightBlue" },
    "diffHighlightRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffAddedBg": { "dark": "darkSelection", "light": "lightSelection" },
    "diffRemovedBg": { "dark": "darkSelection", "light": "lightSelection" },
    "diffContextBg": { "dark": "darkBg", "light": "lightBg" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "darkBg", "light": "lightBg" },
    "diffRemovedLineNumberBg": { "dark": "darkBg", "light": "lightBg" },
    "markdownText": { "dark": "darkFg", "light": "lightFg" },
    "markdownHeading": { "dark": "darkFg", "light": "lightFg" },
    "markdownLink": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLinkText": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownCode": { "dark": "darkOrange", "light": "lightOrange" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkPurple", "light": "lightPurple" },
    "markdownStrong": { "dark": "darkFg", "light": "lightFg" },
    "markdownHorizontalRule": { "dark": "darkSubtle", "light": "lightSubtle" },
    "markdownListItem": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownListEnumeration": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownImage": { "dark": "darkPurple", "light": "lightPurple" },
    "markdownImageText": { "dark": "darkPurple", "light": "lightPurple" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "lightFg" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkPurple", "light": "lightPurple" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxVariable": { "dark": "darkFg", "light": "lightFg" },
    "syntaxString": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxNumber": { "dark": "darkOrange", "light": "lightOrange" },
    "syntaxType": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxOperator": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxPunctuation": { "dark": "darkMuted", "light": "lightMuted" }
  }
}
