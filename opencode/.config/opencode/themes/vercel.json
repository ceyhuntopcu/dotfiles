{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":        { "dark": "#0a0a0a", "light": "#ffffff" },
    "bgPanel":   { "dark": "#101010", "light": "#f5f5f5" },
    "bgElem":    { "dark": "#1f1f1f", "light": "#ebebeb" },
    "fg":        { "dark": "#ededed", "light": "#171717" },
    "fgMuted":   { "dark": "#a0a0a0", "light": "#666666" },
    "accent":    { "dark": "#52a8ff", "light": "#006bff" },
    "purple":    { "dark": "#c472fb", "light": "#7c00c7" },
    "blue":      { "dark": "#52a8ff", "light": "#006bff" },
    "teal":      { "dark": "#00ac3a", "light": "#297a3a" },
    "pink":      { "dark": "#f12b82", "light": "#bd2864" },
    "lavender":  { "dark": "#ededed", "light": "#171717" },
    "rose":      { "dark": "#f12b82", "light": "#bd2864" },
    "comment":   { "dark": "#a1a1a1", "light": "#666666" },
    "border":    { "dark": "#2e2e2e", "light": "#ebebeb" },
    "error":     { "dark": "#f32e40", "light": "#ea001d" },
    "warning":   { "dark": "#ffae00", "light": "#a35200" },
    "success":   { "dark": "#00ac3a", "light": "#297a3a" },
    "info":      { "dark": "#52a8ff", "light": "#006bff" }
  },
  "theme": {
    "primary": "accent",
    "secondary": "purple",
    "accent": "accent",
    "error": "error",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElem",
    "border": "border",
    "borderActive": "accent",
    "borderSubtle": "bgElem",

    "syntaxComment": "comment",
    "syntaxKeyword": "pink",
    "syntaxFunction": "purple",
    "syntaxVariable": "lavender",
    "syntaxString": "teal",
    "syntaxNumber": "blue",
    "syntaxType": "purple",
    "syntaxOperator": "rose",
    "syntaxPunctuation": "lavender",

    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "fgMuted",
    "diffLineNumber": "comment",

    "markdownText": "fg",
    "markdownHeading": "accent",
    "markdownLink": "accent",
    "markdownCode": "teal"
  }
}
