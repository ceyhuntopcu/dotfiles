{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":        { "dark": "#282c34", "light": "#fafafa" },
    "bgPanel":   { "dark": "#21252b", "light": "#f0f0f1" },
    "bgElem":    { "dark": "#2c313a", "light": "#e5e5e6" },
    "fg":        { "dark": "#e6e6e6", "light": "#383a42" },
    "fgMuted":   { "dark": "#abb2bf", "light": "#a0a1a7" },
    "accent":    { "dark": "#61afef", "light": "#4078f2" },
    "purple":    { "dark": "#c678dd", "light": "#a626a4" },
    "blue":      { "dark": "#61afef", "light": "#4078f2" },
    "teal":      { "dark": "#56b6c2", "light": "#0184bc" },
    "pink":      { "dark": "#e06c75", "light": "#e45649" },
    "lavender":  { "dark": "#4dc4ff", "light": "#4078f2" },
    "rose":      { "dark": "#be5046", "light": "#ca1243" },
    "comment":   { "dark": "#4f5666", "light": "#a0a1a7" },
    "border":    { "dark": "#3f4451", "light": "#dcdcdc" },
    "error":     { "dark": "#e06c75", "light": "#e45649" },
    "warning":   { "dark": "#d19a66", "light": "#c18401" },
    "success":   { "dark": "#98c379", "light": "#50a14f" },
    "info":      { "dark": "#61afef", "light": "#4078f2" },
    "diffAddedBg":          { "dark": "#28331f", "light": "#e6f4ea" },
    "diffRemovedBg":        { "dark": "#33231f", "light": "#fbeaea" },
    "diffContextBg":        { "dark": "#282c34", "light": "#fafafa" },
    "diffAddedLineNumberBg":   { "dark": "#1e2818", "light": "#dcefe0" },
    "diffRemovedLineNumberBg": { "dark": "#2c1a18", "light": "#f8dede" }
  },
  "theme": {
    "primary": "accent",
    "secondary": "purple",
    "accent": "accent",
    "error": "error",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElem",
    "border": "border",
    "borderActive": "accent",
    "borderSubtle": "bgElem",

    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "lavender",
    "syntaxString": "teal",
    "syntaxNumber": "pink",
    "syntaxType": "blue",
    "syntaxOperator": "rose",
    "syntaxPunctuation": "lavender",

    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "fgMuted",
    "diffLineNumber": "comment",
    "diffAddedBg": "diffAddedBg",
    "diffRemovedBg": "diffRemovedBg",
    "diffContextBg": "diffContextBg",
    "diffAddedLineNumberBg": "diffAddedLineNumberBg",
    "diffRemovedLineNumberBg": "diffRemovedLineNumberBg",

    "markdownText": "fg",
    "markdownHeading": "accent",
    "markdownLink": "accent",
    "markdownCode": "teal"
  }
