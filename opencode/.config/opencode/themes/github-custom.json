{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":        { "dark": "#151b23", "light": "#ffffff" },
    "bgPanel":   { "dark": "#131920", "light": "#f6f8fa" },
    "bgElem":    { "dark": "#212830", "light": "#eff2f5" },
    "fg":        { "dark": "#f0f6fc", "light": "#1f2328" },
    "fgMuted":   { "dark": "#9198a1", "light": "#59636e" },
    "accent":    { "dark": "#4493f8", "light": "#0969da" },
    "purple":    { "dark": "#d2a8ff", "light": "#8250df" },
    "blue":      { "dark": "#58a6ff", "light": "#0969da" },
    "teal":      { "dark": "#56d4dd", "light": "#1b7c83" },
    "pink":      { "dark": "#ff7b72", "light": "#cf222e" },
    "lavender":  { "dark": "#79c0ff", "light": "#218bff" },
    "rose":      { "dark": "#ffa198", "light": "#a40e26" },
    "comment":   { "dark": "#656c76", "light": "#818b98" },
    "border":    { "dark": "#3d444d", "light": "#d1d9e0" },
    "error":     { "dark": "#f85149", "light": "#cf222e" },
    "warning":   { "dark": "#d29922", "light": "#9a6700" },
    "success":   { "dark": "#3fb950", "light": "#1a7f37" },
    "info":      { "dark": "#58a6ff", "light": "#0969da" },
    "diffAddedBg":          { "dark": "#1a2e1e", "light": "#dafbe1" },
    "diffRemovedBg":        { "dark": "#2b1d1d", "light": "#ffebe9" },
    "diffContextBg":        { "dark": "#151b23", "light": "#ffffff" },
    "diffAddedLineNumberBg":   { "dark": "#14241a", "light": "#c8f0d2" },
    "diffRemovedLineNumberBg": { "dark": "#241616", "light": "#ffd8d4" }
  },
  "theme": {
    "primary": "accent",
    "secondary": "purple",
    "accent": "accent",
    "error": "error",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElem",
    "border": "border",
    "borderActive": "accent",
    "borderSubtle": "bgElem",

    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "lavender",
    "syntaxString": "teal",
    "syntaxNumber": "pink",
    "syntaxType": "blue",
    "syntaxOperator": "rose",
    "syntaxPunctuation": "lavender",

    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "fgMuted",
    "diffLineNumber": "comment",
    "diffAddedBg": "diffAddedBg",
    "diffRemovedBg": "diffRemovedBg",
    "diffContextBg": "diffContextBg",
    "diffAddedLineNumberBg": "diffAddedLineNumberBg",
    "diffRemovedLineNumberBg": "diffRemovedLineNumberBg",

    "markdownText": "fg",
    "markdownHeading": "accent",
    "markdownLink": "accent",
    "markdownCode": "teal"
  }
}
