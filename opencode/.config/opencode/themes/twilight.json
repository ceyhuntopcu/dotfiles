{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":        { "dark": "#1f2335", "light": "#f9f8f4" },
    "bgPanel":   { "dark": "#1a1b26", "light": "#f1f2f6" },
    "bgElem":    { "dark": "#292e42", "light": "#dcdad3" },
    "fg":        { "dark": "#a9b1d6", "light": "#3b4261" },
    "fgMuted":   { "dark": "#8089b3", "light": "#6b7394" },
    "accent":    { "dark": "#7aa2f7", "light": "#4a6bc5" },
    "purple":    { "dark": "#ca9ee6", "light": "#9854c0" },
    "blue":      { "dark": "#8caaee", "light": "#4a6bc5" },
    "teal":      { "dark": "#6eb4bf", "light": "#2e8a96" },
    "pink":      { "dark": "#f0879a", "light": "#c4485a" },
    "lavender":  { "dark": "#c0caf5", "light": "#3b4261" },
    "rose":      { "dark": "#d3b1c8", "light": "#9a7aaa" },
    "comment":   { "dark": "#5f6996", "light": "#9ca3bf" },
    "border":    { "dark": "#2a2e42", "light": "#dcdad3" },
    "error":     { "dark": "#bb616b", "light": "#c4485a" },
    "warning":   { "dark": "#c49a5a", "light": "#a67a30" },
    "success":   { "dark": "#449dab", "light": "#2e8a96" },
    "info":      { "dark": "#0da0ba", "light": "#0b8a9e" }
  },
  "theme": {
    "primary": "accent",
    "secondary": "purple",
    "accent": "accent",
    "error": "error",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElem",
    "border": "border",
    "borderActive": "accent",
    "borderSubtle": "bgElem",

    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "lavender",
    "syntaxString": "teal",
    "syntaxNumber": "pink",
    "syntaxType": "blue",
    "syntaxOperator": "rose",
    "syntaxPunctuation": "lavender",

    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "fgMuted",
    "diffLineNumber": "comment",

    "markdownText": "fg",
    "markdownHeading": "accent",
    "markdownLink": "accent",
    "markdownCode": "teal"
  }
}
