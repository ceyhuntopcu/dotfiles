{
  "$schema": "https://opencode.ai/config.json",

  // Never use OpenCode-hosted models.
  "disabled_providers": ["opencode"],

  // Reuse subscription logins instead of separate API keys/billing:
  // - opencode-claude-auth reads Claude Code's stored OAuth token (org-sanctioned; coworker uses it).
  // - opencode-openai-codex-auth uses a ChatGPT Plus/Pro OAuth login (same idea, for GPT-5.6/Codex).
  "plugin": [
    "opencode-claude-auth@latest",
    "opencode-openai-codex-auth@latest"
  ],

  // Default = Claude Opus 5 via the Claude Code subscription. Cheap background tasks stay on Kimi.
  "model": "anthropic/claude-opus-5",
  "small_model": "fireworks-ai/accounts/fireworks/models/kimi-k2p7-code",

  // Kimi 2.7 Code / K3 via Fireworks (OpenAI-compatible). Key added via `opencode auth login` -> Fireworks.
  // OpenAI GPT-5.6 via the ChatGPT/Codex OAuth plugin above (like pi's `openai-codex` provider) —
  // no separate API key, no OpenRouter route for these.
  // Anthropic Opus 4.8 / Sonnet 5 via OpenRouter (note the '.' in model IDs, unlike Anthropic's own '-' IDs).
  "provider": {
    "fireworks-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": { "baseURL": "https://api.fireworks.ai/inference/v1" },
      "models": {
        "accounts/fireworks/models/kimi-k2p7-code": { "name": "Kimi 2.7 Code" },
        "accounts/fireworks/models/kimi-k3": { "name": "Kimi K3" },
        "accounts/fireworks/models/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "accounts/fireworks/models/glm-5p2": { "name": "GLM 5.2" }
      }
    },
    // ChatGPT Plus/Pro OAuth backend (opencode-openai-codex-auth), mirroring pi's openai-codex
    // provider. store:false + reasoning.encrypted_content are required by this backend.
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {},
      "whitelist": [
        "openai/gpt-5.5",
        "anthropic/claude-opus-4.8",
        "anthropic/claude-opus-5",
        "anthropic/claude-sonnet-5",
        "anthropic/claude-fable-5"
      ],
      "models": {
        "openai/gpt-5.5": { "name": "GPT-5.5" },
        "anthropic/claude-opus-4.8": { "name": "Claude Opus 4.8 (OpenRouter)" },
        "anthropic/claude-opus-5": { "name": "Claude Opus 5 (OpenRouter)" },
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5 (OpenRouter)" },
        "anthropic/claude-fable-5": { "name": "Claude Fable 5 (OpenRouter)" }
      }
    }
  },

  // Per-agent model overrides — build/plan stay on Anthropic (quality matters most
  // there); general/explore move off Anthropic so parallel bursts don't compete
  // with build and don't trigger "provider overloaded". title/summary/compaction
  // are left alone — they already inherit small_model (Kimi).
  "agent": {
    "build": { "model": "anthropic/claude-opus-5" },
    "plan": { "model": "anthropic/claude-opus-5" },
    "general": { "model": "openai/gpt-5.6-sol" },
    "explore": { "model": "fireworks-ai/accounts/fireworks/models/kimi-k2p7-code" }
  },

  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" },
    "playwright": { "type": "local", "command": ["npx", "@playwright/mcp@latest"], "enabled": true },
    "chrome-devtools": { "type": "local", "command": ["npx", "-y", "chrome-devtools-mcp@latest"], "enabled": true },
    // OAuth handled automatically by OpenCode on first use (same as context7).
    "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
    // PAT-based auth (env var, not a secret in this file) — see README for setup.
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" }
    }
  }
}
