{
  "$schema": "https://opencode.ai/config.json",

  // Never use OpenCode-hosted models or OpenRouter.
  "disabled_providers": ["opencode", "openrouter"],

  // Reuse subscription logins instead of separate API keys/billing:
  // - opencode-claude-auth reads Claude Code's stored OAuth token (org-sanctioned; coworker uses it).
  // - opencode-openai-codex-auth uses a ChatGPT Plus/Pro OAuth login (same idea, for GPT-5.6/Codex).
  "plugin": ["opencode-claude-auth@latest", "opencode-openai-codex-auth@latest"],

  // Default = Claude Opus 5 via the Claude Code subscription. Cheap background tasks stay on Kimi.
  "model": "openai/gpt-5.6-sol",
  "small_model": "fireworks-ai/accounts/fireworks/models/glm-5p3-flash",

  // Fireworks models via API key (`opencode auth login` -> Fireworks), OpenAI GPT-5.6 via the
  // ChatGPT/Codex OAuth plugin above (like pi's `openai-codex` provider) — no separate API key.
  // Anthropic models via the claude-auth OAuth plugin. `whitelist` prunes each provider's
  // registry-discovered list down to only the models we actually use.
  "provider": {
    "anthropic": {
      "whitelist": ["claude-fable-5", "claude-fable-5-1", "claude-opus-5", "claude-sonnet-5"]
    },
    "fireworks-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": { "baseURL": "https://api.fireworks.ai/inference/v1" },
      "whitelist": [
        "accounts/fireworks/models/deepseek-v4-flash-0731",
        "accounts/fireworks/models/deepseek-v4-pro",
        "accounts/fireworks/models/kimi-k2p7-code",
        "accounts/fireworks/models/kimi-k3",
        "accounts/fireworks/models/glm-5p3",
        "accounts/fireworks/models/glm-5p3-flash"
      ],
      "models": {
        "accounts/fireworks/models/kimi-k2p7-code": { "name": "Kimi 2.7 Code" },
        "accounts/fireworks/models/kimi-k3": { "name": "Kimi K3" },
        "accounts/fireworks/models/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "accounts/fireworks/models/glm-5p3": { "name": "GLM 5.3" },
        "accounts/fireworks/models/glm-5p3-flash": { "name": "GLM 5.3 Flash" }
      }
    },
    // ChatGPT Plus/Pro OAuth backend (opencode-openai-codex-auth), mirroring pi's openai-codex
    // provider. store:false + reasoning.encrypted_content are required by this backend.
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "whitelist": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"],
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto", "textVerbosity": "medium" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed", "textVerbosity": "medium" }
          }
        }
      }
    }
  },

  // Per-agent model overrides — build/plan stay on Anthropic (quality matters most
  // there); general/explore move off Anthropic so parallel bursts don't compete
  // with build and don't trigger "provider overloaded". title/summary/compaction
  // are left alone — they already inherit small_model (GLM 5.3 Flash).
  "agent": {
    "build": { "model": "anthropic/claude-opus-5" },
    "plan": { "model": "anthropic/claude-fable-5" },
    "general": { "model": "openai/gpt-5.6-sol" },
    "explore": { "model": "fireworks-ai/accounts/fireworks/models/glm-5p3-flash" }
  },

  // Format-on-edit: run detected formatters (Biome, via biome.json) after writes.
  "formatter": true,

  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" },
    "playwright": { "type": "local", "command": ["npx", "@playwright/mcp@latest"], "enabled": true },
    "chrome-devtools": { "type": "local", "command": ["npx", "-y", "chrome-devtools-mcp@latest"], "enabled": true },
    // OAuth handled automatically by OpenCode on first use (same as context7).
    "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
    // PAT-based auth (env var, not a secret in this file) — see README for setup.
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    // OAuth handled automatically by OpenCode on first use (same as context7/linear) —
    // the docs describe a static API-key header, but the live server 401s on that and
    // offers OAuth instead. EU data plane uses https://api-eu.braintrust.dev/mcp instead.
    "braintrust": { "type": "remote", "url": "https://api.braintrust.dev/mcp" },
    // Figma desktop MCP server. The remote server (https://mcp.figma.com/mcp) only
    // allows OAuth clients in Figma's MCP catalog (opencode isn't one -> 403 on
    // registration), so use the local server instead. Requires the Figma desktop
    // app running with "Enable desktop MCP server" toggled on in Dev Mode.
    "figma": { "type": "remote", "url": "http://127.0.0.1:3845/mcp" }
  }
}
