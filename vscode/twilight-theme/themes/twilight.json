    "terminal.ansiBlack": "#414868",
    "terminal.ansiRed": "#f0879a",
    "terminal.ansiGreen": "#6eb4bf",
    "terminal.ansiYellow": "#f0ac8b",
    "terminal.ansiBlue": "#7aa2f7",
    "terminal.ansiMagenta": "#ca9ee6",
    "terminal.ansiCyan": "#8caaee",
    "terminal.ansiWhite": "#a9b1d6",
    "terminal.ansiBrightBlack": "#565f89",
    "terminal.ansiBrightRed": "#f0879a",
    "terminal.ansiBrightGreen": "#6eb4bf",
    "terminal.ansiBrightYellow": "#f0ac8b",
    "terminal.ansiBrightBlue": "#7aa2f7",
