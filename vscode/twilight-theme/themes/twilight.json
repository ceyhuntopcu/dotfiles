    "editorWhitespace.foreground": "#3b4261",
    "editorIndentGuide.background1": "#2a2e44",
    "editorIndentGuide.activeBackground1": "#414868",
    "editorBracketMatch.background": "#3b4261",
    "editorBracketMatch.border": "#7aa2f7",
    "editorError.foreground": "#f0879a",
    "editorWarning.foreground": "#f0ac8b",
