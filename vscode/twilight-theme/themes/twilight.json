    "gitDecoration.untrackedResourceForeground": "#6eb4bf",
    "gitDecoration.ignoredResourceForeground": "#565f89"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#6eb4bf" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#f0ac8b" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#ca9ee6" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"], "settings": { "foreground": "#8caaee" } },
    { "scope": ["variable", "meta.definition.variable.name", "variable.other"], "settings": { "foreground": "#c0caf5" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#a9b1d6" } },
    { "scope": ["entity.name.tag", "support.constant"], "settings": { "foreground": "#f0879a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f0ac8b" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
  ]
}
