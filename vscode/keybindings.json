// VS Code keybindings (ported from Zed).
// Note: cmd-left/right, shift-cmd-left/right, cmd-backspace, alt-backspace,
// and alt-delete are already macOS defaults in VS Code, so they're omitted here.
[
  // Zed: cmd-delete -> DeleteToEndOfLine (not a default on macOS)
  {
    "key": "cmd+delete",
    "command": "deleteAllRight",
    "when": "textInputFocus && !editorReadonly"
  },
  // Toggle line numbers off/on (Settings Cycler; overrides select-all-occurrences)
  {
    "key": "cmd+shift+l",
    "command": "settings.cycle.lineNumbers"
  },
  // Open Source Control panel (mirrors default Ctrl+Shift+G; overrides Find Previous)
  {
    "key": "cmd+shift+g",
    "command": "workbench.view.scm"
  },
  // Split editor side-by-side (default Cmd+\ is unpressable on Canadian layout; overrides Save As)
  {
    "key": "cmd+shift+s",
    "command": "workbench.action.splitEditor"
  },
  // Cmd+Shift+C — Claude Code: open when the right panel is hidden, close the panel when it's open
  {
    "key": "cmd+shift+c",
    "command": "claude-vscode.sidebar.open",
    "when": "!auxiliaryBarVisible"
  },
  {
    "key": "cmd+shift+c",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "auxiliaryBarVisible"
  },
  // Cmd+Shift+I — VS Code Chat (Copilot): same open-when-hidden / close-when-open toggle
  {
    "key": "cmd+shift+i",
    "command": "workbench.action.chat.open",
    "when": "!auxiliaryBarVisible"
  },
  {
    "key": "cmd+shift+i",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "auxiliaryBarVisible"
  }
]
