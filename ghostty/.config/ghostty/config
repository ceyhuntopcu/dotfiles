# Ghostty config.
# Reload with: Cmd+Shift+, in Ghostty (or restart).

# Theme — GitHub Dark / GitHub Light
theme = dark:GitHub-Dark-Custom,light:GitHub-Light-Custom

# Font — Berkeley Mono (licensed). JetBrainsMono Nerd Font kept as fallback for prompt/icon glyphs.
font-family = "Berkeley Mono"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
font-thicken = false
adjust-cell-height = 25%

# Merge title bar into the native tab row to save vertical space.
macos-titlebar-style = tabs

# Padding around the terminal grid.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# Cursor: blinking block.
cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 3

# Hide mouse while typing for a cleaner feel.
mouse-hide-while-typing = true

# Shell integration: prompt marks, jump-between-prompts, working-dir tracking.
shell-integration = detect

# New windows/tabs/splits open in the current pane's directory.
window-inherit-working-directory = true

# Restore window/tab/split layout after quit + reopen.
window-save-state = always

# Don't prompt to confirm when closing a tab/split/window.
confirm-close-surface = false

# Dim inactive splits to make the focused pane obvious.
unfocused-split-opacity = 0.85

# Option+Backspace deletes a word (sends ESC+DEL, which zsh binds to backward-kill-word).
# Without this, Ghostty treats Option as a compose key and the delete doesn't fire.
keybind = opt+backspace=text:\x1b\x7f
keybind = opt+delete=text:\x1bd
