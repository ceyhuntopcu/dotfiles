# Ghostty config.
# Reload with: Cmd+Shift+, in Ghostty (or restart).

# Theme — GitHub Dark matched to Zed's "Github Dark" (Primer palette),
# colors taken from ~/.config/zed/themes/github.json.
theme = GitHub Dark
background = #151b23
foreground = #f0f6fc
cursor-color = #0576ff
cursor-text = #ffffff
selection-background = #0f3f7b
selection-foreground = #ffffff
palette = 0=#2f3742
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#be8fff
palette = 6=#39c5cf
palette = 7=#f0f6fc
palette = 8=#656c76
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 17
adjust-cell-height = 20%

# Opaque window with heavy blur (matches Warp).
background-opacity = 1.0
background-blur-radius = 40

# Merge title bar into the native tab row to save vertical space.
macos-titlebar-style = tabs

# Generous padding around the terminal grid (Warp leaves breathing room).
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true

# Cursor: blinking bar like Warp.
cursor-style = bar
cursor-style-blink = true

# Hide mouse while typing for a cleaner feel.
mouse-hide-while-typing = true

# Smooth scroll feel.
scrollback-limit = 100000

# Option+Backspace deletes a word (sends ESC+DEL, which zsh binds to backward-kill-word).
# Without this, Ghostty treats Option as a compose key and the delete doesn't fire.
keybind = opt+backspace=text:\x1b\x7f
keybind = opt+delete=text:\x1bd
