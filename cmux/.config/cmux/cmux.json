{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // JSONC — comments allowed. Reload with: cmux reload-config

  "app": {
    "appearance": "system",
    "minimalMode": true,
    "hideTabCloseButton": false
  },

  "terminal": {
    "showScrollBar": false
  },

  "sidebarAppearance": {
    "darkModeTintColor": "#0F1117",
    "lightModeTintColor": "#F0EFE9",
    "tintOpacity": 0.6,
    "matchTerminalBackground": true
  }
}
